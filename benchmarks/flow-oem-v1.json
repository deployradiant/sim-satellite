  "primary_metric": "mask_adherence.generated_mean_iou",
  "targets": [
    {
      "metric": "mask_adherence.generated_mean_iou",
      "target": 0.55,
      "direction": "higher",
      "label": "Frozen segmenter recovers the conditioning mask from generated images (mIoU)"
    },
    {
      "metric": "mask_adherence.iou_ratio",
      "target": 0.85,
      "direction": "higher",
      "label": "Generated-image mIoU relative to the segmenter's own real-image mIoU"
    },
    {
      "metric": "generation.ssim",
      "target": 0.35,
      "direction": "higher",
      "label": "Paired SSIM against held-out real images from the same masks"
    },
    {
      "metric": "generation.mask_rgb_mean_mae_macro",
      "target": 0.06,
      "direction": "lower",
      "label": "Per-class RGB mean error between generated and real images"
    },
    {
      "metric": "generation.mask_boundary_gradient_delta",
      "target": 0.015,
      "direction": "lower",
      "label": "Edge sharpness mismatch at semantic boundaries"
    }
